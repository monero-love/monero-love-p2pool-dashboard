[Unit]
Description=Monero Love public P2Pool dashboard
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/p2pool-dashboard
EnvironmentFile=/etc/p2pool-dashboard.env
ExecStart=/usr/bin/python3 /opt/p2pool-dashboard/server.py --port 8792
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=32
[Install]
WantedBy=multi-user.target
